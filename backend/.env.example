# ══════════════════════════════════════════════════════════════════════════════
# ASTRA AI (GPT 6 Astra) — Backend Environment Configuration Example
# ══════════════════════════════════════════════════════════════════════════════

# ── DATABASE ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=astra_saas_production

# ── AUTHENTICATION & SECURITY ─────────────────────────────────────────────────
# Secret key used for internal session/token signatures if applicable
SECRET_KEY=generate_a_random_32_byte_secret_here
# Comma-separated admin emails who can access the /api/admin panel
ADMIN_EMAILS=admin@astra.ai,founder@astra.ai

# ── AI PROVIDERS (Server-side only — never expose in frontend) ────────────────
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_FALLBACK_MODELS=qwen/qwen3.8-27b,groq/compound-mini,groq/compound,openai/gpt-oss-120b
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# ── CASHFREE PAYMENT GATEWAY (Payment Links & PG) ─────────────────────────────
# CASHFREE_ENVIRONMENT: "sandbox" (for development/testing) or "production" (live payments)
CASHFREE_ENVIRONMENT=sandbox
# Cashfree API Credentials (from Cashfree Merchant Dashboard -> Payment Gateway -> API Keys)
CASHFREE_CLIENT_ID=your_cashfree_app_id_or_client_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_here
# Official API version (2023-08-01 recommended)
CASHFREE_API_VERSION=2023-08-01

# Application URLs for payment redirects and webhooks
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS: Comma-separated list of allowed frontend origins
# Development: http://localhost:5173,http://localhost:3000
# Production:  https://gpt-6-astra.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── OPTIONAL: GOOGLE GEMINI (Vision fallback) ─────────────────────────────
# Used as vision fallback when Groq vision quota is exceeded
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── QUOTAS & COST CONTROLS ───────────────────────────────────────────────────
# Daily message allowance for Free users (₹0 plan)
FREE_DAILY_MESSAGES=10
# Daily message allowance for Astra 7-Day Pass holders (₹99 plan)
PREMIUM_DAILY_MESSAGES=100

# Daily document upload limit
FREE_DAILY_DOCUMENTS=2
PREMIUM_DAILY_DOCUMENTS=20

# Max file size limits in Megabytes (prevents memory exhaustion)
MAX_DOCUMENT_SIZE_MB=30
MAX_IMAGE_SIZE_MB=20

# ── RATE LIMITING & DOS PROTECTION ───────────────────────────────────────────
# Max requests per minute per IP / client before receiving HTTP 429
MAX_REQUESTS_PER_MINUTE=30

# ── STORAGE ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=chroma_db
